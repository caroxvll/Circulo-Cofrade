{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/admin-web/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/((?!privacidad\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}
