{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/admin-web/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/eliminar-cuenta",
      "destination": "/eliminar-cuenta.html"
    },
    {
      "source": "/seguridad-infantil",
      "destination": "/seguridad-infantil.html"
    },
    {
      "source": "/((?!privacidad\\.html$|eliminar-cuenta\\.html$|seguridad-infantil\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}
